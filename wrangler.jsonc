{
  "name": "decodedpapers",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "routes": [
    { "pattern": "decodedpapers.xyz/*", "zone_name": "decodedpapers.xyz" },
    { "pattern": "www.decodedpapers.xyz/*", "zone_name": "decodedpapers.xyz" }
  ],
  "observability": {
    "enabled": false
  }
}
